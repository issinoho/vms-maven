$! MAKE_KIT.COM - build the PCSI kit for this node's architecture
$!
$! Usage:  @[.VMSPORT.KIT]MAKE_KIT   (tools/kit.sh runs it after tools/build.sh)
$! Needs a built tree (@[.VMSPORT]BUILD): [.BIN]MVN.EXE, [.BIN]MVNSH.EXE and the
$! patched jars in [.LIB].  Writes the kit to [.KIT_<arch>] in the tree.  The
$! product description, text module, KIT_MATERIAL.COM, MAVEN$CASE.COM and
$! README.VMS were generated by tools/prepare.sh into [.VMSPORT.KIT].
$!
$ set noon
$ status = 44
$ saved_default = f$environment("DEFAULT")
$ saved_parse = f$getjpi("", "PARSE_STYLE_PERM")
$ set process/parse_style=extended
$ proc = f$environment("PROCEDURE")
$ kitdir = f$parse(proc,,,"DEVICE") + f$parse(proc,,,"DIRECTORY")
$ set default 'kitdir'
$ set default [--]
$ arch = f$edit(f$getsyi("ARCH_NAME"), "UPCASE")
$ base = "I64VMS"
$ if arch .eqs. "X86_64" then base = "X86VMS"
$ if arch .eqs. "ALPHA" then base = "AXPVMS"
$!
$! KIT_PRODUCER, PCSI_VERSION, KIT_VERSION from KIT.ENV
$ open/read env [.VMSPORT.KIT]KIT.ENV
$env_loop:
$ read/end=env_done env line
$ name = f$element(0, "=", line)
$ 'name' = f$element(1, "=", line)
$ goto env_loop
$env_done:
$ close env
$!
$ need = "[.BIN]MVN.EXE,[.BIN]MVNSH.EXE,[.VMSPORT.KIT]KIT_MATERIAL.COM"
$ i = 0
$need_loop:
$ f = f$element(i, ",", need)
$ if f .eqs. "," then goto need_done
$ if f$search(f) .eqs. ""
$ then
$   write sys$error "MAKE_KIT: no ''f'; build first (@[.VMSPORT]BUILD)"
$   goto done
$ endif
$ i = i + 1
$ goto need_loop
$need_done:
$!
$! Gather the files flat in [.KIT_<arch>.MAT]: PRODUCT PACKAGE looks each
$! one up by name in the material directory (destinations are in the PDF).
$ mat = "[.KIT_''arch'.MAT]"
$ out = "[.KIT_''arch']"
$ if f$search("KIT_''arch'.DIR") .eqs. "" then create/directory 'out'
$ if f$search("[.KIT_''arch']MAT.DIR") .eqs. "" then create/directory 'mat'
$ if f$search("''out'*.PCSI;*") .nes. "" then delete/nolog 'out'*.PCSI;*
$ if f$search("''mat'*.*;*") .nes. "" then delete/nolog 'mat'*.*;*
$ copy/nolog [.VMSPORT.KIT]MAVEN$STARTUP.COM,MAVEN$SETUP.COM,MAVEN$CASE.COM,README.VMS 'mat'
$ matspec = f$parse(mat,,,"DEVICE","NO_CONCEAL") + f$parse(mat,,,"DIRECTORY","NO_CONCEAL")
$ @[.VMSPORT.KIT]KIT_MATERIAL.COM 'matspec'
$ if .not. $status then goto done
$!
$ write sys$output "MAKE_KIT: ''KIT_PRODUCER' ''base' MAVEN ''PCSI_VERSION' (Maven ''KIT_VERSION')"
$ product package MAVEN -
    /producer='KIT_PRODUCER' /base_system='base' /version='PCSI_VERSION' -
    /source=[.VMSPORT.KIT]MAVEN-'base'.PCSI$DESC -
    /material='matspec' -
    /destination='out' -
    /format=sequential -
    /options=noconfirm
$ status = $status
$ kit = f$search("''out'*.PCSI")
$ if kit .nes. "" then write sys$output "MAKE_KIT: kit ", kit
$ if kit .eqs. "" then status = 44
$done:
$ set process/parse_style='saved_parse'
$ set default 'saved_default'
$ exit status
